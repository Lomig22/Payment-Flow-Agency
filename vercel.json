{
  "redirects": [
    {
      "source": "/candidature",
      "destination": "/candidature/",
      "permanent": false
    },
    {
      "source": "/methode",
      "destination": "/methode/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/methode/",
      "destination": "https://audit-gratuit.vercel.app/"
    },
    {
      "source": "/methode/:path*",
      "destination": "https://audit-gratuit.vercel.app/:path*"
    }
  ]
}
